/*
 * Lily58 keymap — QWERTY + home row mods, tuned for macOS
 * Use cases: coding, Excel, YouTube/browsing without a mouse
 *
 * Layers:
 *   0 default_layer - QWERTY with home row mods (GACS on both hands)
 *   1 lower_layer   - numbers + symbols (held from left thumb)
 *   2 raise_layer   - nav / mouse keys / media (held from right thumb)
 *   3 adjust_layer  - Bluetooth, reset, function keys (Lower+Raise together)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {
        /* Home row mods: tap = letter, hold = modifier.
         * tapping-term-ms/quick-tap-ms tuned to avoid misfires during
         * normal-speed typing; require-prior-idle-ms keeps fast rolling
         * keystrokes registering as taps instead of accidental holds. */
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BSPC |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BSLH  |
// | CTRL  |A/Sft|S/Ctl|D/Alt |F/Gui |  G   |                   |  H   |J/Gui  |K/Alt  |L/Ctl |;/Sft  |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| RCTRL | RALT  |
        default_layer {
            bindings = <
&kp ESC   &kp N1     &kp N2     &kp N3      &kp N4      &kp N5                             &kp N6  &kp N7      &kp N8      &kp N9      &kp N0     &kp BSPC
&kp TAB   &kp Q      &kp W      &kp E       &kp R       &kp T                              &kp Y   &kp U       &kp I       &kp O       &kp P      &kp BSLH
&kp LCTRL &hml LSHFT A &hml LCTRL S &hml LALT D &hml LGUI F &kp G                           &kp H   &hmr RGUI J &hmr RALT K &hmr RCTRL L &hmr RSHFT SEMI &kp SQT
&kp LSHFT &kp Z      &kp X      &kp C       &kp V       &kp B      &kp LBKT   &kp RBKT     &kp N   &kp M       &kp COMMA   &kp DOT     &kp FSLH   &kp RSHFT
                                 &kp LALT    &kp LGUI    &mo 1      &kp SPACE  &kp RET      &mo 2   &kp RCTRL   &kp RALT
            >;
        };

// ------------------------------------------------------------------------------------------------------------
// |  `    | F1  | F2  | F3   | F4   | F5   |                   | F6   | F7    | F8    | F9   |  F10  |  DEL  |
// |  ~    |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |  |    |
// | trans |  -  |  =  |  _   |  +   |  [   |                   |  ]   |  :    |  "    |  <   |   >   |  ?    |
// | trans | trans|trans| trans| trans| trans|  trans |  trans  |trans | trans | trans | trans| trans | trans |
//                     | trans| trans| trans| trans  |  trans  |trans | trans | trans |
        lower_layer {
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                              &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp DEL
&kp TILDE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                          &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp PIPE
&trans     &kp MINUS &kp EQUAL &kp UNDER &kp PLUS  &kp LBRC                          &kp RBRC  &kp COLON &kp DQT   &kp LT    &kp GT    &kp QMARK
&trans     &trans    &trans    &trans    &trans    &trans   &trans     &trans       &trans    &trans    &trans    &trans    &trans    &trans
                                &trans    &trans    &trans   &trans     &trans       &trans    &trans    &trans
            >;
        };

// ------------------------------------------------------------------------------------------------------------
// | F11   | F12 | trans|trans |trans |trans |                   |trans | trans | trans | trans| trans | trans |
// | INS   |trans|trans|SPOTLT|trans |trans |                   |PG_UP |HOME   |  UP   |END   | trans | trans |
// | trans |trans|LALT |LGUI |trans |trans |                    |PG_DN |LEFT   | DOWN  |RIGHT | trans | trans |
// | trans |trans|trans|LCLK |RCLK  |MCLK  | SCRL_UP| SCRL_DOWN |LCLK  |RCLK   | trans | trans| trans | trans |
//                     |trans|trans |trans | trans  |  trans    |VOL_DN|VOL_UP | trans |
        raise_layer {
            bindings = <
&kp F11   &kp F12  &trans   &trans      &trans   &trans                                &trans    &trans     &trans    &trans     &trans   &trans
&kp INS   &trans   &trans   &kp LG(LS(N3)) &trans &trans                               &kp PG_UP &kp HOME   &kp UP    &kp END    &trans   &trans
&trans    &trans   &kp LALT &kp LGUI    &trans   &trans                                &kp PG_DN &kp LEFT   &kp DOWN  &kp RIGHT  &trans   &trans
&trans    &trans   &trans   &mkp LCLK   &mkp RCLK &mkp MCLK  &msc SCRL_UP &msc SCRL_DOWN &mkp LCLK &mkp RCLK  &trans    &trans     &trans   &trans
                             &trans      &trans    &trans     &trans       &trans      &kp C_VOL_DN &kp C_VOL_UP &trans
            >;
        };

// ------------------------------------------------------------------------------------------------------------
// |BT_CLR | none| none| none |none  | none |                   | none | none  | none  | none | none  | none  |
// | none  |BTSEL0|BTSEL1|BTSEL2|BTSEL3|none |                   | none | none  | none  | none | none  | none  |
// | none  | none| none| none |none  | none |                   | none | none  | none  | none | none  | none  |
// | none  | none| none| none |none  | none | BT_DISC0|  none    | none | none  | none  | none | none  | none  |
//                     | none| none |none  | none    |  none    | none | none  | none  |
        adjust_layer {
            bindings = <
&bt BT_CLR &none      &none      &none      &none      &none                          &none  &none  &none  &none  &none  &none
&none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none                    &none  &none  &none  &none  &none  &none
&none      &none      &none      &none      &none      &none                          &none  &none  &none  &none  &none  &none
&none      &none      &none      &none      &none      &none   &bt BT_DISC 0 &none    &none  &none  &none  &none  &none  &none
                                  &none      &none      &none   &none         &none    &none  &none  &none
            >;
        };
    };
};
